# Used by `npm run build:e2e` (vite --mode e2e): the B2C smoke + screenshot tests must never talk to
# production. Nothing listens on this address, so data calls fail fast and pages render signed-out.
# Not a secret: a dummy key for an unreachable local URL.
VITE_SUPABASE_URL=http://127.0.0.1:54399
VITE_SUPABASE_PUBLISHABLE_KEY=e2e-dummy-anon-key
VITE_SUPABASE_PROJECT_ID=e2e
